    public class DormController : ControllerBase
    {
        private readonly clsExternalLayer _clsExternalLayerRepo;
        public DormController(clsExternalLayer clsExternalLayerRepo)
        {
            _clsExternalLayerRepo = clsExternalLayerRepo;
        }

